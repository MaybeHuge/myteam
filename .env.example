NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
# 填写固定页面来源；设置 * 允许任意 HTTP(S) 页面来源，仍要求 Origin、CSRF 和会话校验。
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:replace-with-your-postgres-password@localhost:5432/myteam?schema=public
POSTGRES_PASSWORD=replace-with-your-postgres-password
SESSION_COOKIE=myteam_session
SESSION_TTL_HOURS=8
COOKIE_SECURE=false
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=my-bucket
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PREFIX=attachments/
# 测试默认复用上述服务/凭据，数据库名加 _test、资源桶名加 -test；CI 可显式指定 TEST_DATABASE_URL 和 TEST_S3_*。
# 管理员只在显式初始化命令中创建，修改后执行 admin:create。
ADMIN_EMAIL=admin@example.test
ADMIN_NAME=管理员
ADMIN_PASSWORD=

# 设为 true 时保留隔离库和测试桶中的测试记录。
KEEP_TEST_DATA=false
