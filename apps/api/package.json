{
  "name": "@myteam/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm build && concurrently -k 'tsc -p tsconfig.json --watch' 'node --env-file=../../.env --watch dist/main.js'",
    "start": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "pnpm build && node --env-file=../../.env dist/cli/seed.js",
    "admin:create": "pnpm build && node --env-file=../../.env dist/cli/create-admin.js",
    "storage:prune": "pnpm build && node --env-file=../../.env dist/cli/prune-storage.js",
    "storage:init": "pnpm build && node --env-file=../../.env dist/cli/init-storage.js",
    "storage:migrate-local": "pnpm build && node --env-file=../../.env dist/cli/migrate-local-storage.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@myteam/contracts": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/pg": "^8.15.0",
    "prisma": "7.10.1",
    "supertest": "^7.1.0"
  }
}
